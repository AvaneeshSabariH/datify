# Datify Backend — Environment Variable Template
# Copy this file to .env and fill in your values.

# ── LLM ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Docker Sandbox ──────────────────────────────────────────────────────────────
# Name of the pre-built Docker image used for sandboxed code execution.
# Build it once with: docker build -t datify-sandbox:latest ./backend
SANDBOX_IMAGE=datify-sandbox:latest

# Memory cap enforced on each sandbox container.
SANDBOX_MEM_LIMIT=256m

# Hard wall-clock timeout (seconds) before the container is force-killed.
SANDBOX_TIMEOUT_SEC=10
